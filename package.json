{
  "name": "marktree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "icons": "tauri icon app-icon.svg -o .icons-tmp && node -e \"for (const f of ['icon.ico', 'icon.icns', 'icon.png']) require('fs').copyFileSync('.icons-tmp/' + f, 'src-tauri/icons/' + f); require('fs').rmSync('.icons-tmp', { recursive: true })\""
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
